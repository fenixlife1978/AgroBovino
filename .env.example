# ==============================================================================
# AgroBovino ERP - Variables de Entorno para Despliegue en Vercel & Producción
# ==============================================================================

# 1. Base de Datos Turso (LibSQL Cloud / SQLite Edge)
# Copia tu URL y Token desde la consola de Turso (https://turso.tech)
# Estas variables deben configurarse en: Vercel Dashboard -> Settings -> Environment Variables
VITE_TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
VITE_TURSO_AUTH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Variables del lado del servidor (Opcionales para API Routes / Serverless)
TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
