# AgroBovino ERP - Variables de Entorno
# Configure these ONLY in Vercel (Server/Functions). Never use VITE_* for the Turso token.

TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
TURSO_AUTH_TOKEN=tu-token-de-turso

# Auth (Vercel server-side secrets only)
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_PASSWORD=replace-with-admin-password
VAQUERO_PASSWORD=replace-with-vaquero-password
